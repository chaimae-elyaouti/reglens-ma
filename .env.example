# ============================================================
# Copie ce fichier en .env  (PowerShell : copy .env.example .env)
# .env est dans .gitignore. Ne le publie JAMAIS.
# ============================================================

# --- LLM (génération) : deux fournisseurs gratuits avec bascule automatique ---
# Ordre d'essai. Retire un nom si tu n'as pas de clé pour lui.
LLM_PROVIDERS=groq,gemini

# Clé Groq : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# VERIFIE les noms de modèles et les URLs dans la doc de chaque fournisseur :
# ils changent, et un modèle retiré donne une erreur "model not found".

# --- Embeddings (local, gratuit) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Les modèles E5 exigent ces préfixes. Pour un autre modèle, mets-les à vide si sa fiche ne les demande pas.
QUERY_PREFIX="query: "
PASSAGE_PREFIX="passage: "
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# Optionnel : token Hugging Face (téléchargements plus fiables)
# HF_TOKEN=

# --- Index et retrieval ---
INDEX_DIR=index/v1
TOP_K=5
CANDIDATES=20
RRF_K=60
# Seuil d'abstention sur le score de similarité cosinus. 0 = désactivé.
# À CALIBRER avec : python eval/run_eval.py --sweep   (jour 9 de la feuille de route)
MIN_EVIDENCE_SCORE=0.0
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- API ---
APP_ENV=dev
LOG_LEVEL=INFO
# Par défaut on NE logue PAS le texte des questions (elles peuvent contenir des infos personnelles).
LOG_QUESTIONS=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_IP_PER_DAY=40
MAX_QUESTION_CHARS=600
